# Optional, non-secret reference network values. Required keys: none. Secret keys: none.
# Native binds APP_BIND_HOST; Compose publishes that host and listens separately in container.
APP_BIND_HOST=127.0.0.1
APP_HOST_PORT=8080
APP_CONTAINER_LISTEN_HOST=0.0.0.0
APP_CONTAINER_PORT=8080
APP_HEALTH_PATH=/health
